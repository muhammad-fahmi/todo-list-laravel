# Stage 1: Build React Frontend Assets
FROM node:20-alpine AS frontend-builder

WORKDIR /app

COPY apps/frontend/package*.json ./
RUN npm install

COPY apps/frontend ./
RUN npm run build

# Stage 2: Nginx Production Gateway
FROM nginx:alpine

# Copy custom Nginx configuration
COPY docker/nginx/default.prod.conf /etc/nginx/conf.d/default.conf

# Copy backend public entrypoint for FastCGI routing
COPY apps/backend/public /var/www/backend/public

# Copy pre-compiled frontend static bundle
COPY --from=frontend-builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
